# The variables a topic or payload box offers, and its Insert variable menu.

template-text-device-id = The instance ID, such as office-3
template-text-index = The instance's position in its device: 0, 1, 2, …
template-text-template-id = This template's ID
template-text-seq = The number of the tick in this run, from 0
template-text-now-ms = The time of the tick, in milliseconds since 1970
template-text-now-iso = The time of the tick, such as 2026-11-07T12:00:00.000Z
template-text-field = A field's value on this tick
template-text-param = A param that devices using this template set
template-text-insert-hint = Insert a variable
template-text-insert-name = Insert variable: { $name }
