# The status bar along the bottom of the window.

status-bar-connected = connected
status-bar-cannot-connect = cannot connect
status-bar-connecting = connecting…
status-bar-not-connected = not connected
status-bar-broker-hint = Broker settings
status-bar-online = { $count } online
status-bar-connecting-count = { $count } connecting
status-bar-reconnecting-count = { $count } reconnecting
status-bar-failed-count = { $count } failed
status-bar-nothing-running = nothing running
status-bar-rate = { $rate } msg/s
status-bar-rate-hint = Messages published per second, over the last 5 seconds
status-bar-mcp-on = MCP on :{ $port }
status-bar-mcp-on-hint = AI agents can control this window at http://{ $address }/mcp
status-bar-mcp-off = MCP off
status-bar-mcp-off-hint = AI agents cannot control this window; turn MCP on in the settings
status-bar-release = Senzor { $version } is out
status-bar-release-hint = See what's new and download it
