# Value types, typing hints, override summaries and password sources of the editors.

edits-value-text = text
edits-value-number = number
edits-value-bool = bool
edits-use-number = use a number, e.g. 42 or 22.5
edits-use-bool = use true or false

edits-not-overridden = not overridden
# The settings a field's override changes, e.g. "start, max overridden".
edits-overridden = { $settings } overridden

edits-password-none = none
edits-password-literal = in the file
edits-password-env = from env var
