# Typy hodnot, nápovědy při psaní, souhrny přepsání a zdroje hesla v editorech.

edits-value-text = text
edits-value-number = číslo
edits-value-bool = bool
edits-use-number = zadejte číslo, např. 42 nebo 22.5
edits-use-bool = zadejte true nebo false

edits-not-overridden = nepřepsáno
# Nastavení, která přepsání pole mění, např. „přepsáno: start, max“.
edits-overridden = přepsáno: { $settings }

edits-password-none = žádné
edits-password-literal = v souboru
edits-password-env = z proměnné prostředí
