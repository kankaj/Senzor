# Proměnné, které nabízí pole topicu nebo payloadu, a jeho nabídka Vložit proměnnou.

template-text-device-id = ID instance, například office-3
template-text-index = Pořadí instance v jejím zařízení: 0, 1, 2, …
template-text-template-id = ID této šablony
template-text-seq = Číslo ticku v tomto běhu, od 0
template-text-now-ms = Čas ticku v milisekundách od roku 1970
template-text-now-iso = Čas ticku, například 2026-11-07T12:00:00.000Z
template-text-field = Hodnota pole v tomto ticku
template-text-param = Parametr, který nastavují zařízení používající tuto šablonu
template-text-insert-hint = Vložit proměnnou
template-text-insert-name = Vložit proměnnou: { $name }
